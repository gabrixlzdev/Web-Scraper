# ==============================================================================
# Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` for local customization:
# cp .env.example .env (or copy/paste manually)

# Run browser in headless mode? (True for background/server, False to see the browser window)
HEADLESS=True

# Default timeout in milliseconds (30 seconds)
SCRAPER_TIMEOUT=30000

# Base URL for searches
BASE_URL=https://www.zillow.com
