# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Duplicate this file as `.env` for local configuration:
# cp .env.example .env

# Target URL for the scraping demonstration
TARGET_URL=https://www.zillow.com

# Headless mode:
# - True: Runs silently in the background (cloud servers, Docker, scheduled jobs)
# - False: Opens a visual browser window (live client demos, visual debugging)
HEADLESS=False

# Maximum navigation/action timeout in milliseconds (30000ms = 30 seconds)
SCRAPER_TIMEOUT=30000
