# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Duplicate this file as `.env` for local configuration:
# copy .env.example .env (Windows) or cp .env.example .env (Linux/Mac)

# Target search URL (points directly to homes for sale where listing cards render)
TARGET_URL=https://www.zillow.com/homes/for_sale/

# Headless mode:
# - True: Runs silently in background (Docker, cloud servers)
# - False: Opens a visual browser window (client demos, visual verification)
HEADLESS=False

# Maximum navigation/action timeout in milliseconds (30000ms = 30 seconds)
SCRAPER_TIMEOUT=30000

# Directory where persistent session cookies and browser state are saved
USER_DATA_DIR=browser_profile
